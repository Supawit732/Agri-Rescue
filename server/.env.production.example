# University server deploy (119.59.102.161). Copy to server/.env and fill in
# real values — never commit the filled-in file.

# Public port pm2/express listens on (only 3064 is opened for you on this host)
PORT=3064

# MySQL — same machine as the app, DB already created manually from
# docs/database/schema.sql, so DB_HOST is localhost, not a remote IP.
DB_HOST=localhost
DB_PORT=3306
DB_USER=std6730202700
DB_PASSWORD=
DB_NAME=ip_std6730202700

# Signs auth tokens — use a long random string, not the dev default.
JWT_SECRET=change-me

# Optional: collection depot coordinates used for delivery-distance math.
# Falls back to a built-in default if unset.
DEPOT_LAT=13.65
DEPOT_LNG=100.62

# Optional: AI photo-assessment provider. Leave AI_VISION_API_KEY blank to
# disable the feature (server degrades gracefully, no crash).
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_VISION_TIMEOUT_MS=30000

# Optional: set to 1 to skip the background MOC price-sync job (e.g. if the
# external price API is unreachable from this host/offline demo).
MOC_SYNC_SKIP=

# Optional: absolute path to the built web app (mobile/dist, uploaded via
# sftp — see docs/DEPLOY_UNIVERSITY.md step 8). Defaults to server/public
# (relative to the compiled server/dist/app.js) if unset. Only matters if
# you uploaded the web build under a different folder name/location.
WEB_DIST_DIR=

# --- Not env vars on purpose ---
# Upload directory: hardcoded to server/uploads (relative to the compiled
# code), not configurable — see src/storage/publicUploads.ts.
# Public URL / CORS: the API returns uploads as relative paths (e.g.
# "/uploads/lots/xyz.jpg") and CORS already allows any origin
# (src/app.ts), so no PUBLIC_URL/CORS_ORIGIN var is needed — the mobile
# app resolves relative URLs against its own EXPO_PUBLIC_API_URL
# (see mobile/src/lib/media.ts).
