{
  "expo": {
    "name": "Agri-Rescue",
    "slug": "agri-rescue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agri-rescue",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ใช้ตำแหน่งเพื่อระบุที่อยู่ตอนสมัครและตำแหน่งแปลงเกษตร"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ใช้ตำแหน่งเพื่อระบุที่อยู่ตอนสมัครและตำแหน่งแปลงเกษตร"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ใช้เลือกรูปผลผลิตเพื่อประเมินความสุก",
          "cameraPermission": "ใช้ถ่ายรูปผลผลิตเพื่อประเมินความสุก"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
